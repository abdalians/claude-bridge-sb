# Claude Bridge — environment reference
# These variables are set in the systemd service (claude-bridge.service).
# Copy and adapt if running outside systemd.

# Home directory for the service user. The server resolves the credentials
# file as $HOME/.claude/.credentials.json
HOME=/home/openclaw

# API key is NOT set via an environment variable — it is stored in the
# credentials file at $HOME/.claude/.credentials.json in one of two forms:
#
# Option A — direct API key:
# {
#   "apiKey": "sk-ant-...",
#   "expiresAt": 9999999999999
# }
#
# Option B — Claude OAuth token (if using claude.ai login):
# {
#   "claudeAiOauth": {
#     "accessToken": "sk-ant-oat01-..."
#   }
# }
#
# You can also push a key at runtime without touching the file:
#   curl -X POST http://<host>:3456/token-push \
#        -H 'Content-Type: application/json' \
#        -d '{"apiKey":"sk-ant-..."}'
